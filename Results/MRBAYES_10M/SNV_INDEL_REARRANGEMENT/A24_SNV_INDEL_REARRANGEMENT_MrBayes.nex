#NEXUS

BEGIN DATA;
    DIMENSIONS NTAX=5 NCHAR=521;
    FORMAT DATATYPE=RESTRICTION MISSING=?;
    MATRIX
    A24-A    
    A24-C    
    A24-D    
    A24-E    
    Normal    
    ;
END;

BEGIN MRBAYES;
    SET AUTOCLOSE=YES SEED=2026 SWAPSEED=2026;
    LSET CODING=VARIABLE RATES=EQUAL;
    PRSET STATEFREQPR=DIRICHLET(1.0,1.0);
    OUTGROUP Normal;
    MCMCP NGEN=10000000 NRUNS=2 NCHAINS=4 SAMPLEFREQ=1000
          PRINTFREQ=1000 DIAGNFREQ=10000 SAVEBRLENS=YES
          FILENAME=A24_SNV_INDEL_REARRANGEMENT;
    MCMC;
    SUMP RELBURNIN=YES BURNINFRAC=0.25;
    SUMT RELBURNIN=YES BURNINFRAC=0.25;
END;
