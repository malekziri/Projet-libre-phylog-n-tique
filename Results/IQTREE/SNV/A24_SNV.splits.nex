#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A24-A'
[2] 'A24-C'
[3] 'A24-D'
[4] 'A24-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=15;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 3,
	31	 1 3,
	100	 2,
	96	 4 5,
	100	 5,
	100	 4,
	37	 2 3,
	2	 1 5,
	32	 1 2,
	1	 1 4,
	1	 2 4,
	1	 3 4,
	0	 3 5,
	0	 2 5,
;
END; [Splits]

