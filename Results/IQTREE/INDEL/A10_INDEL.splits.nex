#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A10-A'
[2] 'A10-C'
[3] 'A10-D'
[4] 'A10-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=15;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 3,
	7	 1 3,
	100	 4,
	28	 2 5,
	100	 5,
	100	 2,
	66	 1 4,
	21	 3 5,
	35	 2 3,
	10	 2 4,
	18	 1 5,
	5	 4 5,
	4	 1 2,
	8	 3 4,
;
END; [Splits]

