#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A24-A'
[2] 'A24-C'
[3] 'A24-D'
[4] 'A24-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=15;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 3,
	21	 1 3,
	100	 2,
	100	 4,
	31	 2 4,
	100	 5,
	19	 1 4,
	24	 2 3,
	16	 1 2,
	18	 4 5,
	24	 3 5,
	12	 2 5,
	11	 3 4,
	23	 1 5,
;
END; [Splits]

