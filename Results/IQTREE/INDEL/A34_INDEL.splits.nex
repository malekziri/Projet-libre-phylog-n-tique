#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A34-A'
[2] 'A34-C'
[3] 'A34-D'
[4] 'A34-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=11;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 2,
	100	 3,
	97	 2 3,
	100	 4,
	5	 1 5,
	100	 5,
	100	 1,
	92	 4 5,
	3	 1 4,
	3	 1 2,
	1	 1 3,
;
END; [Splits]

