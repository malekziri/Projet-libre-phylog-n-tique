#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A24-A'
[2] 'A24-C'
[3] 'A24-D'
[4] 'A24-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=15;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 2,
	64	 1 2,
	100	 3,
	60	 4 5,
	100	 5,
	100	 4,
	11	 2 3,
	7	 1 5,
	5	 1 4,
	10	 2 5,
	9	 1 3,
	26	 3 4,
	7	 3 5,
	3	 2 4,
;
END; [Splits]

