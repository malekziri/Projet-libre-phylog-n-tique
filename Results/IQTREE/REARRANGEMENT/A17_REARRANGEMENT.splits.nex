#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'A17-A'
[2] 'A17-C'
[3] 'A17-D'
[4] 'A17-E'
[5] 'A17-F'
[6] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=21;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 3,
	70	 1 3,
	100	 2,
	100	 5,
	73	 2 5,
	16	 4 6,
	100	 6,
	100	 4,
	42	 1 3 6,
	12	 1 6,
	39	 1 3 4,
	17	 5 6,
	6	 1 4,
	9	 2 6,
	13	 3 6,
	1	 3 4,
	1	 1 4 6,
	0	 1 2 5,
	1	 2 4,
	0	 4 5,
;
END; [Splits]

