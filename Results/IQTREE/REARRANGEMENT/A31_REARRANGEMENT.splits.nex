#nexus

BEGIN Taxa;
DIMENSIONS ntax=6;
TAXLABELS
[1] 'A31-A'
[2] 'A31-C'
[3] 'A31-D'
[4] 'A31-E'
[5] 'A31-F'
[6] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=6 nsplits=26;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 2,
	35	 1 2,
	100	 3,
	50	 1 2 3,
	100	 4,
	42	 5 6,
	100	 6,
	100	 5,
	31	 2 3,
	51	 4 5,
	35	 1 4 5,
	14	 2 6,
	7	 1 3,
	2	 4 6,
	4	 1 4,
	3	 1 2 6,
	16	 3 6,
	1	 3 4,
	3	 1 5 6,
	1	 1 2 4,
	1	 1 5,
	3	 2 4,
	0	 1 6,
	0	 1 3 4,
	0	 1 3 6,
;
END; [Splits]

