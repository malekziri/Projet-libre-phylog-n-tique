#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A10-A'
[2] 'A10-C'
[3] 'A10-D'
[4] 'A10-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=11;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 2,
	100	 3,
	75	 2 3,
	29	 4 5,
	100	 5,
	100	 4,
	50	 1 4,
	11	 3 5,
	21	 1 5,
	14	 2 5,
;
END; [Splits]

