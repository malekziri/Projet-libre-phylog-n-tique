#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A24-A'
[2] 'A24-C'
[3] 'A24-D'
[4] 'A24-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=15;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 3,
	10	 1 3,
	100	 2,
	100	 4,
	3	 2 4,
	100	 5,
	63	 1 2,
	61	 4 5,
	10	 2 3,
	10	 3 5,
	22	 3 4,
	7	 1 5,
	5	 1 4,
	9	 2 5,
;
END; [Splits]

