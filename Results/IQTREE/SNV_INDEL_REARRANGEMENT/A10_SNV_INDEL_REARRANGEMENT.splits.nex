#nexus

BEGIN Taxa;
DIMENSIONS ntax=5;
TAXLABELS
[1] 'A10-A'
[2] 'A10-C'
[3] 'A10-D'
[4] 'A10-E'
[5] 'Normal'
;
END; [Taxa]

BEGIN Splits;
DIMENSIONS ntax=5 nsplits=11;
FORMAT labels=no weights=yes confidences=no intervals=no;
MATRIX
	100	 1,
	100	 4,
	64	 1 4,
	100	 2,
	10	 3 5,
	100	 5,
	100	 3,
	66	 2 3,
	23	 2 5,
	10	 1 5,
	26	 4 5,
;
END; [Splits]

